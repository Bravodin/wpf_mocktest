<Application x:Class="ErpMock.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ErpMock.App.ViewModels"
             xmlns:v="clr-namespace:ErpMock.App.Views"
             xmlns:conv="clr-namespace:ErpMock.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:SaleStatusToTextConverter x:Key="StatusText" />
            <conv:PersonTypeToTextConverter x:Key="PersonTypeText" />
            <conv:LevelToBrushConverter x:Key="LevelBrush" />

            <!-- Navegação ViewModel-first: o ContentControl escolhe a View pelo tipo do ViewModel. -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomersViewModel}"><v:CustomersView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProductsViewModel}"><v:ProductsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SalesViewModel}"><v:SalesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><v:ReportsView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
