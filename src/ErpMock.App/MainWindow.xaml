<Window x:Class="ErpMock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ErpMock.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="ERP Mock" Height="820" Width="1400" MinHeight="600" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Menu lateral -->
        <DockPanel Background="{StaticResource SidebarBrush}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="24,28,0,32">
                <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="E" Foreground="White" FontWeight="Bold" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ERP Mock" Foreground="White" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Gestão comercial" Foreground="{StaticResource SidebarTextBrush}" FontSize="11" />
                </StackPanel>
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom" Margin="24,0,0,20" FontSize="11"
                       Foreground="{StaticResource SidebarTextBrush}" Text="WPF • .NET 10 • MVVM" />

            <StackPanel>
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Dashboard" IsChecked="True"
                             Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE716;" Content="Clientes"
                             Command="{Binding NavigateCommand}" CommandParameter="Customers" />
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE7B8;" Content="Produtos"
                             Command="{Binding NavigateCommand}" CommandParameter="Products" />
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE7BF;" Content="Vendas"
                             Command="{Binding NavigateCommand}" CommandParameter="Sales" />
                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8A5;" Content="Relatórios"
                             Command="{Binding NavigateCommand}" CommandParameter="Reports" />
            </StackPanel>
        </DockPanel>

        <!-- Conteúdo: a View é resolvida pelo DataTemplate do ViewModel atual (App.xaml) -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="28,24" Focusable="False" />
    </Grid>
</Window>
