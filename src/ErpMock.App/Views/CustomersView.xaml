<UserControl x:Class="ErpMock.App.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErpMock.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="760"
             d:DataContext="{d:DesignInstance vm:CustomersViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Text="Clientes" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

        <!-- Barra de ferramentas -->
        <DockPanel Grid.Row="1" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding EditCommand}" AutomationProperties.Name="Editar" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Editar" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding DeleteCommand}" AutomationProperties.Name="Excluir" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Excluir" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding NewCommand}" AutomationProperties.Name="Novo">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Novo cliente" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox Style="{StaticResource SearchBox}" Tag="Buscar por nome, documento, e-mail, cidade..."
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Somente ativos" IsChecked="{Binding OnlyActive}" Margin="16,0,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NOME" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="TIPO" Binding="{Binding Type, Converter={StaticResource PersonTypeText}}" Width="55" />
                            <DataGridTextColumn Header="CPF / CNPJ" Binding="{Binding Document}" Width="150" />
                            <DataGridTextColumn Header="E-MAIL" Binding="{Binding Email}" Width="1.5*" />
                            <DataGridTextColumn Header="TELEFONE" Binding="{Binding Phone}" Width="130" />
                            <DataGridTextColumn Header="CIDADE / UF" Width="*">
                                <DataGridTextColumn.Binding>
                                    <MultiBinding StringFormat="{}{0} / {1}">
                                        <Binding Path="City" />
                                        <Binding Path="State" />
                                    </MultiBinding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="SITUAÇÃO" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Badge}"
                                                Background="{Binding IsActive, Converter={StaticResource LevelBrush}, ConverterParameter=Light}">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" x:Name="Txt" Text="Ativo"
                                                       Foreground="{Binding IsActive, Converter={StaticResource LevelBrush}}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter TargetName="Txt" Property="Text" Value="Inativo" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ProgressBar Style="{StaticResource BusyBar}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <!-- Painel de edição -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Width="360" Margin="16,0,0,0"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Command="{Binding CancelEditCommand}"
                                IsCancel="True" Margin="0,0,8,0" />
                        <Button Content="Salvar" Command="{Binding SaveCommand}" IsDefault="True" />
                    </StackPanel>

                    <ScrollViewer DataContext="{Binding Editor, ValidatesOnNotifyDataErrors=False}" VerticalScrollBarVisibility="Auto"
                                  d:DataContext="{d:DesignInstance vm:CustomerEditorViewModel}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="Tipo de pessoa" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding PersonTypes}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                      SelectedValue="{Binding Type}" />

                            <TextBlock Text="Nome / Razão social" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="{Binding DocumentLabel}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Document, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Telefone" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Phone}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Cidade" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding City}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="UF" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding State}" />
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Cliente ativo" IsChecked="{Binding IsActive}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
