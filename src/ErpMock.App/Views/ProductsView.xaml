<UserControl x:Class="ErpMock.App.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErpMock.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="760"
             d:DataContext="{d:DesignInstance vm:ProductsViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Text="Produtos" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

        <DockPanel Grid.Row="1" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding EditCommand}" AutomationProperties.Name="Editar" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Editar" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding DeleteCommand}" AutomationProperties.Name="Excluir" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Excluir" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding NewCommand}" AutomationProperties.Name="Novo">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Novo produto" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox Style="{StaticResource SearchBox}" Tag="Buscar por nome, SKU, categoria..."
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Somente ativos" IsChecked="{Binding OnlyActive}" Margin="16,0,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
                        </DataGrid.InputBindings>
                        <!-- Destaca linhas com estoque abaixo do mínimo -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100" />
                            <DataGridTextColumn Header="PRODUTO" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="CATEGORIA" Binding="{Binding Category}" Width="*" />
                            <DataGridTextColumn Header="CUSTO" Binding="{Binding Cost, StringFormat=C}" Width="110"
                                                ElementStyle="{StaticResource RightCell}" />
                            <DataGridTextColumn Header="PREÇO" Binding="{Binding Price, StringFormat=C}" Width="110"
                                                ElementStyle="{StaticResource RightCell}" />
                            <DataGridTextColumn Header="MARGEM" Binding="{Binding Margin, StringFormat=P1}" Width="80"
                                                ElementStyle="{StaticResource RightCell}" />
                            <DataGridTextColumn Header="ESTOQUE" Binding="{Binding Stock}" Width="80"
                                                ElementStyle="{StaticResource RightCell}" />
                            <DataGridTextColumn Header="MÍN." Binding="{Binding MinStock}" Width="60"
                                                ElementStyle="{StaticResource RightCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <ProgressBar Style="{StaticResource BusyBar}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Width="360" Margin="16,0,0,0"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Command="{Binding CancelEditCommand}"
                                IsCancel="True" Margin="0,0,8,0" />
                        <Button Content="Salvar" Command="{Binding SaveCommand}" IsDefault="True" />
                    </StackPanel>

                    <ScrollViewer DataContext="{Binding Editor, ValidatesOnNotifyDataErrors=False}" VerticalScrollBarVisibility="Auto"
                                  d:DataContext="{d:DesignInstance vm:ProductEditorViewModel}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="SKU" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" />

                            <TextBlock Text="Nome" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Categoria" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Categories}" IsEditable="True"
                                      Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Custo (R$)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Cost, StringFormat=N2}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Preço de venda (R$)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Price, StringFormat=N2}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding MarginText}" Style="{StaticResource Muted}" Margin="0,6,0,0" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Estoque" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Stock}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Estoque mínimo" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding MinStock}" />
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Produto ativo" IsChecked="{Binding IsActive}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
