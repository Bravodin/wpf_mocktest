<UserControl x:Class="ErpMock.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErpMock.App.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="800"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}">
    <UserControl.Resources>
        <!-- Card de KPI -->
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,2" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <!-- Barra horizontal com rótulo e valor -->
        <DataTemplate x:Key="HorizontalBar" DataType="{x:Type vm:BarItem}">
            <StackPanel Margin="0,0,0,12">
                <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value, StringFormat=C}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMutedBrush}" />
                </DockPanel>
                <Border Height="8" CornerRadius="4" Background="{StaticResource BackgroundBrush}">
                    <Border CornerRadius="4" Background="{StaticResource AccentBrush}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Ratio}" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Cabeçalho -->
                <DockPanel Margin="0,0,0,20">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Command="{Binding LoadCommand}" AutomationProperties.Name="Atualizar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Atualizar" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="13"
                                   Text="{Binding Source={x:Static sys:DateTime.Today}, StringFormat='Visão geral — {0:MMMM \'de\' yyyy}'}" />
                    </StackPanel>
                </DockPanel>

                <!-- KPIs -->
                <UniformGrid Columns="4" Margin="-8,0,-8,16">
                    <Border Style="{StaticResource Card}" Margin="8">
                        <StackPanel>
                            <TextBlock Text="Faturamento no mês" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Summary.RevenueThisMonth, StringFormat=C}" Style="{StaticResource KpiValue}" />
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Badge}"
                                        Background="{Binding Summary.RevenueGrowth, Converter={StaticResource LevelBrush}, ConverterParameter=Light}">
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               Text="{Binding Summary.RevenueGrowth, StringFormat={}{0:+0.0%;-0.0%;0%}}"
                                               Foreground="{Binding Summary.RevenueGrowth, Converter={StaticResource LevelBrush}}" />
                                </Border>
                                <TextBlock Text=" vs. mês anterior" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8">
                        <StackPanel>
                            <TextBlock Text="Vendas no mês" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Summary.SalesThisMonth}" Style="{StaticResource KpiValue}" />
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="{Binding Summary.RevenueLastMonth, StringFormat='Mês anterior: {0:C}'}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8">
                        <StackPanel>
                            <TextBlock Text="Ticket médio" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Summary.AverageTicket, StringFormat=C}" Style="{StaticResource KpiValue}" />
                            <TextBlock Text="Vendas faturadas no mês" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8">
                        <StackPanel>
                            <TextBlock Text="Clientes ativos" Style="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Summary.ActiveCustomers}" Style="{StaticResource KpiValue}" />
                            <TextBlock Foreground="{StaticResource WarningBrush}" FontSize="12"
                                       Text="{Binding Summary.LowStockProducts, StringFormat='{}{0} produto(s) com estoque baixo'}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Gráfico mensal + categorias -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Faturamento — últimos 12 meses" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding MonthlyBars}" Height="230">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BarItem}">
                                        <Grid Margin="5,0" Background="Transparent">
                                            <Grid.ToolTip>
                                                <TextBlock Text="{Binding Value, StringFormat=C}" />
                                            </Grid.ToolTip>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Rectangle x:Name="Bar" Fill="{StaticResource AccentBrush}" RadiusX="3" RadiusY="3"
                                                       RenderTransformOrigin="0.5,1">
                                                <Rectangle.RenderTransform>
                                                    <ScaleTransform ScaleY="{Binding Ratio}" />
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                            <TextBlock Grid.Row="1" Text="{Binding Label}" Style="{StaticResource Muted}"
                                                       FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bar" Property="Fill" Value="{StaticResource AccentDarkBrush}" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Faturamento por categoria" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding CategoryBars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BarItem}">
                                        <StackPanel Margin="0,0,0,14">
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Share, StringFormat=P1}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMutedBrush}" />
                                            </DockPanel>
                                            <Border Height="8" CornerRadius="4" Background="{StaticResource BackgroundBrush}">
                                                <Border CornerRadius="4" Background="{StaticResource SuccessBrush}" RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding Share}" />
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                            <TextBlock Text="{Binding Value, StringFormat=C}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Top produtos / últimas vendas / estoque baixo -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Top 5 produtos (12 meses)" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding TopProductBars}" ItemTemplate="{StaticResource HorizontalBar}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Últimas vendas" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding Summary.RecentSales}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Number, StringFormat='#{0}'}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Customer.Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Date, StringFormat='dd/MM/yyyy HH:mm'}" Style="{StaticResource Muted}" FontSize="11" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat=C}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Estoque baixo" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Nenhum produto abaixo do mínimo. 👍" Style="{StaticResource Muted}"
                                       Visibility="{Binding Summary.LowStock.Count, Converter={StaticResource NullToVis}, ConverterParameter=Invert, FallbackValue=Collapsed}" />
                            <ItemsControl ItemsSource="{Binding Summary.LowStock}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,10">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" VerticalAlignment="Center"
                                                    Background="{StaticResource WarningLightBrush}">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}">
                                                    <Run Text="{Binding Stock, Mode=OneWay}" /> / <Run Text="{Binding MinStock, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Sku}" Style="{StaticResource Muted}" FontSize="11" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <ProgressBar Style="{StaticResource BusyBar}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,-24,0,0" />
    </Grid>
</UserControl>
