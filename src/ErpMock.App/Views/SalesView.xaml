<UserControl x:Class="ErpMock.App.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErpMock.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="760"
             d:DataContext="{d:DesignInstance vm:SalesViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CancelSaleCommand}" AutomationProperties.Name="Cancelar venda" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Cancelar venda" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding NewSaleCommand}" AutomationProperties.Name="Nova venda">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Nova venda" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="Vendas" Style="{StaticResource PageTitle}" />
        </DockPanel>

        <!-- Filtros -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Vendas faturadas" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding CompletedCount}" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Total no período" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding TotalAmount, StringFormat=C}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="De" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding From}" Width="130" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Até" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding To}" Width="130" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Status" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding Status}" Width="120" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Cliente ou nº" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource SearchBox}" Width="220" Tag="Buscar..."
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding LoadCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <Button Content="Filtrar" Command="{Binding LoadCommand}" VerticalAlignment="Bottom" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Lista -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                          RowDetailsVisibilityMode="VisibleWhenSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nº" Binding="{Binding Number}" Width="70" />
                        <DataGridTextColumn Header="DATA" Binding="{Binding Date, StringFormat='dd/MM/yyyy HH:mm'}" Width="140" />
                        <DataGridTextColumn Header="CLIENTE" Binding="{Binding Customer.Name}" Width="2*" />
                        <DataGridTextColumn Header="ITENS" Binding="{Binding Items.Count}" Width="60"
                                            ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal, StringFormat=C}" Width="120"
                                            ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="DESCONTO" Binding="{Binding Discount, StringFormat=C}" Width="110"
                                            ElementStyle="{StaticResource RightCell}" />
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=C}" Width="120"
                                            ElementStyle="{StaticResource RightCell}" FontWeight="SemiBold" />
                        <DataGridTemplateColumn Header="STATUS" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}"
                                            Background="{Binding Status, Converter={StaticResource LevelBrush}, ConverterParameter=Light}">
                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                   Text="{Binding Status, Converter={StaticResource StatusText}}"
                                                   Foreground="{Binding Status, Converter={StaticResource LevelBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <!-- Itens da venda selecionada -->
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BackgroundBrush}" Padding="80,8,24,12">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Product.Sku}" Style="{StaticResource Muted}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Product.Name}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat='{}{0} un.'}" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="{Binding UnitPrice, StringFormat='× {0:C}'}" HorizontalAlignment="Right" Style="{StaticResource Muted}" />
                                                <TextBlock Grid.Column="4" Text="{Binding Total, StringFormat=C}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
                <ProgressBar Style="{StaticResource BusyBar}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!-- Overlay: nova venda -->
        <Grid Grid.RowSpan="3" Margin="-28,-24" Background="#990F172A"
              Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="880" MaxHeight="680" VerticalAlignment="Center"
                    DataContext="{Binding Editor, ValidatesOnNotifyDataErrors=False}" d:DataContext="{d:DesignInstance vm:SaleEditorViewModel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" AutomationProperties.Name="Fechar"
                                Command="{Binding CancelCommand}" />
                        <TextBlock Text="Nova venda" Style="{StaticResource PageTitle}" FontSize="20" />
                    </DockPanel>

                    <!-- Rodapé com totais -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Desconto (R$)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Discount, StringFormat=N2}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Observações" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Notes}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="24,0,0,0" VerticalAlignment="Bottom">
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource Muted}"
                                       Text="{Binding Subtotal, StringFormat='Subtotal: {0:C}'}" />
                            <TextBlock HorizontalAlignment="Right" FontSize="22" FontWeight="SemiBold"
                                       Text="{Binding Total, StringFormat=C}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                                <Button Content="Faturar venda" Command="{Binding SaveCommand}" Background="{StaticResource SuccessBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Cliente" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                                  DisplayMemberPath="Name" IsEditable="True" IsTextSearchEnabled="True" />

                        <TextBlock Text="Adicionar produto" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                                      IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="560">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Sku}" Foreground="Gray" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat=C}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{Binding Stock, StringFormat='Estq: {0}'}" HorizontalAlignment="Right" Foreground="Gray" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Grid.Column="1" Margin="8,0" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalContentAlignment="Right" />
                            <Button Grid.Column="2" Command="{Binding AddItemCommand}" AutomationProperties.Name="Adicionar">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Adicionar" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" MinHeight="180">
                        <Grid>
                            <DataGrid ItemsSource="{Binding Items}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SKU" Binding="{Binding Product.Sku}" Width="90" />
                                    <DataGridTextColumn Header="PRODUTO" Binding="{Binding Product.Name}" Width="*" />
                                    <DataGridTextColumn Header="QTD" Binding="{Binding Quantity}" Width="60" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTextColumn Header="PREÇO UNIT." Binding="{Binding UnitPrice, StringFormat=C}" Width="110" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=C}" Width="120" ElementStyle="{StaticResource RightCell}" />
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remover"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Nenhum item lançado." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Items.Count, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
