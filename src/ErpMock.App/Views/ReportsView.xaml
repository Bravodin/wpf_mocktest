<UserControl x:Class="ErpMock.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErpMock.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="760"
             d:DataContext="{d:DesignInstance vm:ReportsViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Relatórios" Style="{StaticResource PageTitle}" Margin="0,0,0,16" Grid.ColumnSpan="3" />

        <!-- Lista de relatórios -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="8" Padding="14,10" Margin="0,2" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BackgroundBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Parâmetros + resultado -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="20,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportCsvCommand}" AutomationProperties.Name="Exportar CSV" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Exportar CSV" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding PrintCommand}" AutomationProperties.Name="Imprimir">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE749;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Imprimir / PDF" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding UsesPeriod, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="De" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                <DatePicker SelectedDate="{Binding From}" Width="130" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Até" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                                <DatePicker SelectedDate="{Binding To}" Width="130" />
                            </StackPanel>
                        </StackPanel>
                        <Button Content="Gerar relatório" Command="{Binding GenerateCommand}" VerticalAlignment="Bottom" />
                    </StackPanel>
                </DockPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Footer}" FontWeight="SemiBold" />
                </Border>

                <Grid>
                    <DataGrid ItemsSource="{Binding Result}" AutoGenerateColumns="True"
                              AutoGeneratingColumn="OnAutoGeneratingColumn" BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="0,1,0,0" />
                    <TextBlock Text="Escolha um relatório e clique em &quot;Gerar relatório&quot;." Style="{StaticResource Muted}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Result, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                    <ProgressBar Style="{StaticResource BusyBar}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
