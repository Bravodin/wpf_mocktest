<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Core: regras de negócio. Api + Client: a API em memória chamada pelo mesmo cliente HTTP que o WPF usa. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\ErpMock.Core\ErpMock.Core.csproj" />
    <ProjectReference Include="..\..\src\ErpMock.Api\ErpMock.Api.csproj" />
    <ProjectReference Include="..\..\src\ErpMock.Client\ErpMock.Client.csproj" />
  </ItemGroup>

</Project>
